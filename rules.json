{
  "extends": [
    "config:base",
    ":disableRateLimiting",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tbilisi",
  "updateNotScheduled": false,
  "schedule": [
    "before 5am on Saturday"
  ],
  "packageRules": [
    {
      "updateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": false
    },
    {
      "updateTypes": [
        "major"
      ],
      "masterIssueApproval": true
    },
    {
      "description": "A peer range stays a single range. Renovate's \"auto\" strategy widens peerDependencies, which appends \"|| ^next\" instead of replacing the range, so a package ends up declaring support for majors it was never tested against.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "replace"
    },
    {
      "matchDepNames": ["@ethberry/eslint-config"],
      "allowedVersions": "<6"
    },
    {
      "matchDepNames": ["@liaoliaots/nestjs-redis"],
      "allowedVersions": "<10"
    },
    {
      "description": "Node.js types follow the runtime major (Node 26).",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<27"
    },
    {
      "description": "TypeScript stays on 5.x: the toolchain (ts-jest, typescript-eslint, NestJS, webpack) is not moved to 6.x yet.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6"
    },
    {
      "description": "Node.js stays on 26, the LTS line (.nvmrc, engines, Docker images, CI node-version).",
      "matchPackageNames": ["node"],
      "allowedVersions": "<27"
    },
    {
      "matchPackageNames": ["cron"],
      "groupName": "@NestJS packages",
      "rangeStrategy": "replace",
      "enabled": false
    },
    {
      "matchPackagePrefixes": ["@framework/"],
      "enabled": false
    },
    {
      "matchPackagePrefixes": ["@ethberry/"],
      "commitMessageTopic": "EthBerry",
      "groupName": "@EthBerry packages",
      "groupSlug": "ethberry-packages",
      "rollbackPrs": false
    },
    {
      "matchPackagePrefixes": ["@mui/"],
      "commitMessageTopic": "MaterialUI",
      "groupName": "@MUI packages",
      "groupSlug": "mui-packages"
    },
    {
      "matchPackagePrefixes": ["@nestjs/"],
      "commitMessageTopic": "NestJS",
      "groupName": "@NestJS packages",
      "groupSlug": "nestjs-packages"
    },
    {
      "matchPackagePrefixes": ["@lexical/"],
      "matchPackageNames": ["lexical"],
      "commitMessageTopic": "Lexical",
      "groupName": "@Lexical packages",
      "groupSlug": "lexical"
    },
    {
      "matchPackagePrefixes": ["@storybook/"],
      "matchPackageNames": ["storybook"],
      "commitMessageTopic": "Storybook",
      "groupName": "@Storybook packages",
      "groupSlug": "storybook"
    }
  ],
  "major": {
    "masterIssueApproval": true
  },
  "npm": {
    "description": [
      "Workaround: lockfiles are regenerated with npm 11, not npm 12.",
      "npm 12 defaults to allow-remote=none and, because of a bug, treats the registry tarball of a package with bundleDependencies as a remote download, so `npm install --package-lock-only` fails with EALLOWREMOTE and the PR gets a failed renovate/artifacts check.",
      "Seen on @tailwindcss/oxide-wasm32-wasi (optional dependency of tailwindcss 4) in TrejGun/nestjs-langchain-demo; reproduced with npm 12.2.3, npm 11 works.",
      "Remove this once https://github.com/npm/cli/issues/9800 is fixed in a released npm 12."
    ],
    "constraints": {
      "npm": "<12"
    }
  },
  "dependencyDashboard": true,
  "npmrc": "@ethberry:registry=https://npm.pkg.github.com/",
  "npmrcMerge": true
}
